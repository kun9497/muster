# A hash comment, which named accepts alongside the other two spellings.
// A C++ comment.
/* A C comment that spans two lines and carries { braces } and a ;
   inside it, none of which is a token. */
options {
	directory "/var/named"; # a trailing hash comment
	allow-transfer { key "tsig"; }; // only the peer holding this TSIG key
};

zone "example.org" IN {
	type master;
	/* the brace in this file name belongs to the string */
	file "/var/named/example.org{1}.zone";
	allow-update { none; };
};
