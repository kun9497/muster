# synthetic grub.cfg with no password: the hash appears in a comment only
### BEGIN /etc/grub.d/01_users ###
# password_pbkdf2 root grub.pbkdf2.sha512.10000.SALT.HASH
# GRUB2_PASSWORD=grub.pbkdf2.sha512.10000.SALT.HASH
### END /etc/grub.d/01_users ###

set default="0"
set superusers="root"
menuentry 'Linux' {
	linux /vmlinuz root=/dev/sda1 ro quiet
}
