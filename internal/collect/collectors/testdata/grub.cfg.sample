# synthetic grub.cfg: a generated menu whose 01_users section names a superuser
### BEGIN /etc/grub.d/00_header ###
set default="0"
set timeout=5
### END /etc/grub.d/00_header ###

### BEGIN /etc/grub.d/01_users ###
set superusers="root"
export superusers
password_pbkdf2 root grub.pbkdf2.sha512.10000.SALT.HASH
### END /etc/grub.d/01_users ###

menuentry 'Linux' {
	linux /vmlinuz root=/dev/sda1 ro quiet
	initrd /initrd.img
}
