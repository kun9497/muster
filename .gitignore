# build output
/bin/
/dist/
# tools/refindex downloads the pinned DISA STIG and CCI zips here, and
# tools/suidindex the pinned .deb archives
/.cache/
# `go build ./cmd/muster`, `go build ./tools/...` and `go test -c` drop these
# at the repository root
/muster
/muster.exe
/coverage
/coverage.exe
/refindex
/refindex.exe
/suidindex
/suidindex.exe
*.test
*.test.exe

# IDE and editor state
/.idea/
/.vscode/
*.swp

# never commit the KISA guide PDFs or raw page dumps (licensing); only the item inventory JSON/MD is tracked
docs/reference/kisa/*.pdf
docs/reference/kisa/*_text.txt
docs/reference/kisa/pages*.json

# local snapshots captured while developing
/*.json
!/.*.json

# harness worktrees and subagent-driven-development scratch
/.claude/worktrees/
/.superpowers/
